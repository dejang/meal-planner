{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meal Planner",
  "version": "0.1.0",
  "identifier": "com.meal-planner.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ui run dev",
    "beforeBuildCommand": "pnpm --dir ui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "title": "Meal Planner", "width": 1280, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: image: http://image.localhost https://image.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon-256.png", "icons/favicon.ico"],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
